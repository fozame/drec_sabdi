# Copier ce fichier en « .env » puis adapter les valeurs.
# (./scripts/deployer.sh le fait automatiquement et génère la clé secrète.)

# Version de l'image (reprise du fichier VERSION par les scripts)
SABDI_VERSION=latest

# Clé de signature des sessions : longue chaîne aléatoire, à ne pas modifier ensuite
# (la modifier déconnecte tous les utilisateurs).
SABDI_SECRET=

# Mot de passe du compte « admin » créé au premier démarrage uniquement.
# À changer dès la première connexion (menu « Mot de passe »).
SABDI_ADMIN_PASSWORD=admin123

# Port d'accès sur le serveur : http://<adresse-du-serveur>:5600
SABDI_PORT_HOTE=5600

# Emplacements sur le serveur
SABDI_DONNEES=./donnees
SABDI_DEPOTS=./depots

# Mémoire maximale du conteneur (16 M de lignes ≈ 6 Go ; laisser 2 Go au système)
SABDI_MEMOIRE=13g

# Fils d'exécution du serveur web
SABDI_THREADS=8

# Processeur ancien (« Illegal instruction ») : mettre rtcompat puis reconstruire
SABDI_POLARS_RUNTIME=

TZ=Africa/Douala
